{
  "name": "PostVote",
  "type": "object",
  "properties": {
    "post_id": {
      "type": "string",
      "description": "Id of the voted post"
    },
    "user_id": {
      "type": "string",
      "description": "Id of the member who voted"
    },
    "value": {
      "type": "number",
      "default": 1,
      "description": "1 for an upvote, -1 for a downvote"
    }
  },
  "required": [
    "post_id",
    "user_id",
    "value"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "user_condition": {
                "data.approval_status": "approved"
              }
            }
          ]
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "data.approval_status": "approved"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}