{"name":"AnnouncementRead","properties":{"announcement_author_id":{"description":"User id of the announcement's author, copied at read time so the author may read the rows (and the read count) for their own announcement under RLS, which cannot join back to Announcement","type":"string"},"announcement_id":{"description":"Id of the announcement that was seen","type":"string"},"batch":{"description":"Id of the announcement's batch — its teachers and coordinator may read these rows to show a read count","type":"string"},"user_id":{"description":"Id of the member who saw the announcement","type":"string"}},"required":["announcement_id","user_id","batch"],"rls":{"create":{"$and":[{"created_by_id":"{{user.id}}"},{"data.user_id":"{{user.id}}"},{"user_condition":{"data.approval_status":"approved"}}]},"delete":{"user_condition":{"role":"admin"}},"read":{"$or":[{"user_condition":{"role":"admin"}},{"created_by_id":"{{user.id}}"},{"data.announcement_author_id":"{{user.id}}"},{"$and":[{"data.batch":"{{user.data.batch}}"},{"user_condition":{"data.staff_role":"teacher"}}]},{"$and":[{"data.batch":"{{user.data.batch}}"},{"user_condition":{"data.staff_role":"coordinator"}}]}]},"update":{"user_condition":{"role":"admin"}}},"type":"object"}