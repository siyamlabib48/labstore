{
  "name": "Friendship",
  "type": "object",
  "properties": {
    "requester_id": {
      "type": "string",
      "description": "User id of the person who sent the request"
    },
    "recipient_id": {
      "type": "string",
      "description": "User id of the person who received the request"
    },
    "requester_name": {
      "type": "string",
      "description": "Requester display name snapshot"
    },
    "requester_lab": {
      "type": "string",
      "description": "Requester lab key snapshot"
    },
    "recipient_name": {
      "type": "string",
      "description": "Recipient display name snapshot"
    },
    "recipient_lab": {
      "type": "string",
      "description": "Recipient lab key snapshot"
    },
    "note": {
      "type": "string",
      "description": "Optional short note the sender attached to the request"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "rejected"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red"
      ],
      "default": "pending",
      "description": "Connection state between the two members. A rejected row is kept (not deleted) so the refusal is on record; it never blocks a fresh request"
    }
  },
  "required": [
    "requester_id",
    "recipient_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.status": "accepted"
            },
            {
              "user_condition": {
                "data.approval_status": "approved"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.requester_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "data.approval_status": "approved"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.recipient_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "data.approval_status": "approved"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    // Friendships are created ONLY by the manageFriendApproval backend
    // function (service role, which bypasses RLS): directly for same-gender
    // or staff requests, or after teacher/coordinator approval for
    // different-gender student requests. Client-side creation is admin-only
    // so the approval gate cannot be bypassed by a crafted request.
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.requester_id": "{{user.id}}"
        },
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}