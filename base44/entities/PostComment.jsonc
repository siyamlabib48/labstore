{
  "name": "PostComment",
  "type": "object",
  "properties": {
    "post_id": {
      "type": "string",
      "description": "Id of the post this comment belongs to"
    },
    "parent_id": {
      "type": "string",
      "description": "Id of the comment being replied to, empty for a top-level comment"
    },
    "body": {
      "type": "string",
      "description": "Comment text"
    },
    "batch": {
      "type": "string",
      "description": "Id of the batch whose wall this comment belongs to — for comments this is the parent post's batch, which may differ from the commenter's own batch on academy posts"
    },
    "post_visibility": {
      "type": "string",
      "enum": [
        "academy",
        "batch",
        "lab",
        "private"
      ],
      "enumColors": [
        "blue",
        "green",
        "purple",
        "gray"
      ],
      "description": "Visibility of the parent post, copied from the post at creation time. Comments written before this field existed carry no value and stay batch-scoped; only 'academy' opens a comment to approved members of other batches"
    },
    "author_name": {
      "type": "string",
      "description": "Comment author display name snapshot"
    },
    "author_lab": {
      "type": "string",
      "description": "Comment author lab key snapshot"
    }
  },
  "required": [
    "post_id",
    "body",
    "batch"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "user_condition": {
                "data.approval_status": "approved"
              }
            },
            {
              "data.batch": "{{user.data.batch}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "user_condition": {
                "data.approval_status": "approved"
              }
            },
            {
              "data.post_visibility": "academy"
            }
          ]
        }
      ]
    },
    "create": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "data.approval_status": "approved"
                  }
                },
                {
                  "data.batch": "{{user.data.batch}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "data.approval_status": "approved"
                  }
                },
                {
                  "data.post_visibility": "academy"
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.batch": "{{user.data.batch}}"
            },
            {
              "user_condition": {
                "data.staff_role": "teacher"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.batch": "{{user.data.batch}}"
            },
            {
              "user_condition": {
                "data.staff_role": "coordinator"
              }
            }
          ]
        }
      ]
    }
  }
}