{
  "name": "Report",
  "type": "object",
  "properties": {
    "batch": {
      "description": "Id of the batch the reported content belongs to — staff of this batch handle the report",
      "type": "string"
    },
    "details": {
      "description": "Optional extra context from the reporter",
      "type": "string"
    },
    "reason": {
      "description": "Why the member is reporting the content",
      "enum": [
        "spam",
        "harassment",
        "inappropriate",
        "misinformation",
        "other"
      ],
      "enumColors": [
        "gray",
        "red",
        "yellow",
        "purple",
        "blue"
      ],
      "type": "string"
    },
    "status": {
      "default": "pending",
      "description": "Staff handling state: waiting, content removed, or dismissed without action",
      "enum": [
        "pending",
        "actioned",
        "dismissed"
      ],
      "enumColors": [
        "yellow",
        "green",
        "gray"
      ],
      "type": "string"
    },
    "target_id": {
      "description": "Id of the reported post or comment",
      "type": "string"
    },
    "target_type": {
      "description": "Whether the reported content is a feed post or a comment",
      "enum": [
        "post",
        "comment"
      ],
      "enumColors": [
        "blue",
        "purple"
      ],
      "type": "string"
    }
  },
  "required": [
    "target_type",
    "target_id",
    "batch",
    "reason"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "data.approval_status": "approved"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.batch": "{{user.data.batch}}"
            },
            {
              "user_condition": {
                "data.staff_role": "teacher"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.batch": "{{user.data.batch}}"
            },
            {
              "user_condition": {
                "data.staff_role": "coordinator"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.batch": "{{user.data.batch}}"
            },
            {
              "user_condition": {
                "data.staff_role": "teacher"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.batch": "{{user.data.batch}}"
            },
            {
              "user_condition": {
                "data.staff_role": "coordinator"
              }
            }
          ]
        }
      ]
    }
  }
}
