{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "body": {
      "type": "string",
      "description": "Message text. May be an empty string when the message carries attachments only — the field stays required at the entity level, the client sends '' for attachment-only messages."
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file_uri": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "size_bytes": {
            "type": "number"
          }
        }
      },
      "description": "Private files attached to the message, same shape as Work attachments"
    },
    "scope": {
      "type": "string",
      "enum": [
        "batch",
        "lab"
      ],
      "enumColors": [
        "blue",
        "purple"
      ],
      "default": "batch",
      "description": "Whether the message belongs to the whole batch room or a single lab room"
    },
    "batch": {
      "type": "string",
      "description": "Id of the batch this room belongs to"
    },
    "lab": {
      "type": "string",
      "description": "Lab key of a lab room, empty for batch rooms"
    },
    "author_name": {
      "type": "string",
      "description": "Author display name snapshot"
    },
    "author_lab": {
      "type": "string",
      "description": "Author lab key snapshot"
    }
  },
  "required": [
    "body",
    "scope",
    "batch"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.batch": "{{user.data.batch}}"
            },
            {
              "user_condition": {
                "data.approval_status": "approved"
              }
            },
            {
              "$or": [
                {
                  "data.scope": "batch"
                },
                {
                  "$and": [
                    {
                      "data.scope": "lab"
                    },
                    {
                      "data.lab": "{{user.data.lab}}"
                    }
                  ]
                },
                {
                  "$and": [
                    {
                      "data.scope": "lab"
                    },
                    {
                      "user_condition": {
                        "data.staff_role": "teacher"
                      }
                    }
                  ]
                },
                {
                  "$and": [
                    {
                      "data.scope": "lab"
                    },
                    {
                      "user_condition": {
                        "data.staff_role": "coordinator"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.batch": "{{user.data.batch}}"
            },
            {
              "user_condition": {
                "data.approval_status": "approved"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}