{
  "name": "Post",
  "type": "object",
  "properties": {
    "content": {
      "type": "string",
      "description": "The story, update or question written by the member"
    },
    "image_uri": {
      "type": "string",
      "description": "Private storage uri of an optional attached image"
    },
    "batch": {
      "type": "string",
      "description": "Id of the batch whose wall this post belongs to"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "academy",
        "batch",
        "lab",
        "private"
      ],
      "enumColors": [
        "blue",
        "green",
        "purple",
        "gray"
      ],
      "default": "batch",
      "description": "Who may read the post: the whole academy, the author's batch, the author's lab, or the author alone"
    },
    "author_name": {
      "type": "string",
      "description": "Author display name snapshot"
    },
    "author_lab": {
      "type": "string",
      "description": "Author lab key snapshot at publish time \u2014 lab-visibility reads compare against this, not the author's live lab"
    },
    "edited": {
      "type": "boolean",
      "default": false,
      "description": "Set true once the author edits the post text after publishing"
    }
  },
  "required": [
    "content",
    "batch"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "user_condition": {
                "data.approval_status": "approved"
              }
            },
            {
              "$or": [
                {
                  "data.visibility": "academy"
                },
                {
                  "$and": [
                    {
                      "data.visibility": "batch"
                    },
                    {
                      "data.batch": "{{user.data.batch}}"
                    }
                  ]
                },
                {
                  "$and": [
                    {
                      "data.visibility": "lab"
                    },
                    {
                      "data.batch": "{{user.data.batch}}"
                    },
                    {
                      "data.author_lab": "{{user.data.lab}}"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "create": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "data.approval_status": "approved"
                  }
                },
                {
                  "data.batch": "{{user.data.batch}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.batch": "{{user.data.batch}}"
            },
            {
              "user_condition": {
                "data.staff_role": "teacher"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.batch": "{{user.data.batch}}"
            },
            {
              "user_condition": {
                "data.staff_role": "coordinator"
              }
            }
          ]
        }
      ]
    }
  }
}