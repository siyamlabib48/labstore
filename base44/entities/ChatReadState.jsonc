{"name":"ChatReadState","properties":{"last_read_at":{"description":"ISO timestamp up to which the member has seen this room's messages","format":"date-time","type":"string"},"room_key":{"description":"Room identifier in the form '<batchId>:batch' or '<batchId>:lab:<labKey>' — the same key the chat page uses to pick a room","type":"string"},"user_id":{"description":"Id of the member this read state belongs to","type":"string"}},"required":["user_id","room_key","last_read_at"],"rls":{"create":{"$and":[{"created_by_id":"{{user.id}}"},{"data.user_id":"{{user.id}}"},{"user_condition":{"data.approval_status":"approved"}}]},"delete":{"user_condition":{"role":"admin"}},"read":{"$or":[{"created_by_id":"{{user.id}}"},{"user_condition":{"role":"admin"}}]},"update":{"$or":[{"created_by_id":"{{user.id}}"},{"user_condition":{"role":"admin"}}]}},"type":"object"}