{"name":"FriendApprovalRequest","properties":{"batch":{"description":"Id of the requester's batch — its coordinator may decide, alongside the requester's lab teacher","type":"string"},"decided_by":{"description":"User id of the staff member who approved or rejected the request","type":"string"},"decision_reason":{"description":"Why the request was rejected (required on rejection); shared privately with the requester","type":"string"},"lab":{"description":"Requester's lab key — the teacher of this lab in this batch may decide","type":"string"},"note":{"description":"Optional short note the sender attached to the request, carried onto the Friendship when approved","type":"string"},"recipient_id":{"description":"User id of the member the requester wants to connect with","type":"string"},"recipient_name":{"description":"Recipient display name snapshot","type":"string"},"requester_id":{"description":"User id of the student who wants to send the friend request","type":"string"},"requester_name":{"description":"Requester display name snapshot","type":"string"},"status":{"default":"pending","description":"Staff decision state for the held friend request","enum":["pending","approved","rejected"],"enumColors":["yellow","green","red"],"type":"string"}},"required":["requester_id","recipient_id"],"rls":{"create":{"$and":[{"data.requester_id":"{{user.id}}"},{"user_condition":{"data.approval_status":"approved"}}]},"delete":{"user_condition":{"role":"admin"}},"read":{"$or":[{"user_condition":{"role":"admin"}},{"$and":[{"data.requester_id":"{{user.id}}"},{"user_condition":{"data.approval_status":"approved"}}]},{"$and":[{"data.recipient_id":"{{user.id}}"},{"user_condition":{"data.approval_status":"approved"}}]},{"$and":[{"user_condition":{"data.staff_role":"teacher"}},{"data.batch":"{{user.data.batch}}"},{"data.lab":"{{user.data.lab}}"}]},{"$and":[{"user_condition":{"data.staff_role":"coordinator"}},{"data.batch":"{{user.data.batch}}"}]}]},"update":{"$or":[{"user_condition":{"role":"admin"}},{"$and":[{"user_condition":{"data.staff_role":"teacher"}},{"data.batch":"{{user.data.batch}}"},{"data.lab":"{{user.data.lab}}"}]},{"$and":[{"user_condition":{"data.staff_role":"coordinator"}},{"data.batch":"{{user.data.batch}}"}]}]}},"type":"object"}