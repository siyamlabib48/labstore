{
  "name": "Work",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Title of the submitted work"
    },
    "description": {
      "type": "string",
      "description": "Short description or notes about the work"
    },
    "work_type": {
      "type": "string",
      "enum": [
        "social_post",
        "document",
        "illustrator",
        "wordpress",
        "other"
      ],
      "default": "other"
    },
    "batch": {
      "type": "string",
      "description": "Id of the Batch this work was submitted in"
    },
    "lab": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "Ai"
      ],
      "description": "Lab group of the student who submitted the work"
    },
    "link": {
      "type": "string",
      "description": "Public link (social post URL or live website URL)"
    },
    "cover_file_uri": {
      "type": "string",
      "description": "Private storage uri of the cover image / screenshot"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file_uri": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "size_bytes": {
            "type": "number"
          }
        }
      }
    },
    "file_size_bytes": {
      "type": "number",
      "description": "Total bytes stored for this work"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "all",
        "lab",
        "private"
      ],
      "default": "all"
    },
    "creator_name": {
      "type": "string"
    },
    "leader_score": {
      "type": "number"
    },
    "leader_note": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "work_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.visibility": "all"
            },
            {
              "data.batch": "{{user.data.batch}}"
            }
          ]
        },
        {
          "$and": [
            {
              "data.visibility": "lab"
            },
            {
              "data.lab": "{{user.data.lab}}"
            },
            {
              "data.batch": "{{user.data.batch}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.is_lab_leader": true
              }
            },
            {
              "data.lab": "{{user.data.lab}}"
            },
            {
              "data.batch": "{{user.data.batch}}"
            },
            {
              "data.visibility": {
                "$ne": "private"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.staff_role": "teacher"
              }
            },
            {
              "data.visibility": "lab"
            },
            {
              "data.batch": "{{user.data.batch}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.staff_role": "coordinator"
              }
            },
            {
              "data.visibility": "lab"
            },
            {
              "data.batch": "{{user.data.batch}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.batch": "{{user.data.batch}}"
            },
            {
              "user_condition": {
                "data.approval_status": "approved"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.is_lab_leader": true
              }
            },
            {
              "data.lab": "{{user.data.lab}}"
            },
            {
              "data.batch": "{{user.data.batch}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.staff_role": "teacher"
              }
            },
            {
              "data.batch": "{{user.data.batch}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.staff_role": "coordinator"
              }
            },
            {
              "data.batch": "{{user.data.batch}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.is_lab_leader": true
              }
            },
            {
              "data.lab": "{{user.data.lab}}"
            },
            {
              "data.batch": "{{user.data.batch}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.staff_role": "teacher"
              }
            },
            {
              "data.batch": "{{user.data.batch}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.staff_role": "coordinator"
              }
            },
            {
              "data.batch": "{{user.data.batch}}"
            }
          ]
        }
      ]
    }
  }
}