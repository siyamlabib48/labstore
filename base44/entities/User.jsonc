{
  "name": "User",
  "type": "object",
  "properties": {
    "batch": {
      "type": "string",
      "description": "Id of the Batch this member belongs to, assigned by the owner or batch coordinator",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "staff_role": {
      "type": "string",
      "enum": [
        "owner",
        "coordinator",
        "teacher",
        "cr",
        "acr",
        "member"
      ],
      "enumColors": [
        "purple",
        "blue",
        "green",
        "yellow",
        "pink",
        "gray"
      ],
      "default": "member",
      "description": "Academy role inside the app (distinct from the platform admin/user role)",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "lab": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "Ai"
      ],
      "description": "Lab group assigned by the owner",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Sign-up approval state, managed by the owner",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female"
      ],
      "enumColors": [
        "blue",
        "pink"
      ],
      "description": "Self-declared gender (self-editable). Used only by the friend-approval safeguard: a student's friend request to a different-gender student is routed to staff for approval first"
    },
    "is_lab_leader": {
      "type": "boolean",
      "default": false,
      "description": "Lab leader flag, set by the owner",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "headline": {
      "type": "string",
      "description": "Short one-line intro shown under the member's name (self-editable)"
    },
    "bio": {
      "type": "string",
      "description": "Longer profile bio written by the member (self-editable)"
    },
    "avatar_url": {
      "type": "string",
      "description": "Public URL of the member's profile photo (self-editable)"
    },
    "website": {
      "type": "string",
      "description": "Portfolio or social link shown on the profile (self-editable)"
    },
    "cover_photo": {
      "type": "string",
      "description": "Public URL of the member's profile cover photo (self-editable)"
    },
    "current_institution": {
      "type": "string",
      "description": "Where the member currently studies or works (self-editable, privacy-controlled)"
    },
    "previous_institution": {
      "type": "string",
      "description": "Where the member previously studied or worked (self-editable, privacy-controlled)"
    },
    "marital_status": {
      "type": "string",
      "enum": [
        "single",
        "married"
      ],
      "enumColors": [
        "green",
        "purple"
      ],
      "description": "Self-declared marital status (self-editable, privacy-controlled, defaults to only-me visibility)"
    },
    "website_privacy": {
      "type": "string",
      "enum": [
        "everyone",
        "batch",
        "friends",
        "only_me"
      ],
      "enumColors": [
        "blue",
        "green",
        "purple",
        "gray"
      ],
      "description": "Who may see the website field on the profile: everyone, own batch, friends, or only the member. Unset means the server default (batch)"
    },
    "gender_privacy": {
      "type": "string",
      "enum": [
        "everyone",
        "batch",
        "friends",
        "only_me"
      ],
      "enumColors": [
        "blue",
        "green",
        "purple",
        "gray"
      ],
      "description": "Who may see the gender field on the profile. Unset means the server default (batch)"
    },
    "current_institution_privacy": {
      "type": "string",
      "enum": [
        "everyone",
        "batch",
        "friends",
        "only_me"
      ],
      "enumColors": [
        "blue",
        "green",
        "purple",
        "gray"
      ],
      "description": "Who may see the current institution field on the profile. Unset means the server default (batch)"
    },
    "previous_institution_privacy": {
      "type": "string",
      "enum": [
        "everyone",
        "batch",
        "friends",
        "only_me"
      ],
      "enumColors": [
        "blue",
        "green",
        "purple",
        "gray"
      ],
      "description": "Who may see the previous institution field on the profile. Unset means the server default (batch)"
    },
    "marital_status_privacy": {
      "type": "string",
      "enum": [
        "everyone",
        "batch",
        "friends",
        "only_me"
      ],
      "enumColors": [
        "blue",
        "green",
        "purple",
        "gray"
      ],
      "description": "Who may see the marital status field on the profile. Unset means the server default (only_me)"
    }
  }
}